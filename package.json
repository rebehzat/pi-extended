{
  "name": "pi-extended",
  "version": "0.1.3",
  "description": "pi package: search (DuckDuckGo + Tavily), background terminals with write_stdin, view_image, web_run (pages/PDF/images/weather/finance/sports/time), goals, and session-persistent subagents",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "extensions/*.ts",
      "!extensions/lib.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "^24.0.0",
    "jiti": "^2.7.0",
    "typebox": "latest",
    "typescript": "^5.6.0",
    "@earendil-works/pi-tui": "latest"
  }
}
